{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
      "builder": "RAILPACK"
    },
    "deploy": {
      "runtime": "V2",
      "numReplicas": 1,
      "limitOverride": {
        "containers": {
          "cpu": 1,
          "memoryBytes": 2000000000
        }
      },
      "sleepApplication": true,
      "useLegacyStacker": false,
      "multiRegionConfig": {
        "asia-southeast1-eqsg3a": {
          "numReplicas": 1
        }
      },
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }
